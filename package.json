{
  "name": "toolbox",
  "version": "1.0.0",
  "private": true,
  "description": "Personal toolbox - multi-app monorepo available at toolbox.junaid.guru",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace=apps/gateway",
    "start": "npm run start --workspace=apps/gateway"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
